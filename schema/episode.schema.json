{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clean99/new-circle/schema/episode.schema.json",
  "title": "anchor-training episode",
  "description": "One line of areas/relationship/episodes.jsonl. scripts/anchor_core/episodes.py is the executable version of this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "date", "source_ref", "trigger", "my_thought", "body", "urge", "certainty", "action",
               "script_used", "outcome", "outcome_fact", "recovery_minutes", "suds_peak", "miss",
               "miss_conditions", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^ep-\\d{4}-\\d{2}-\\d{2}-\\d{2}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 400},
    "trigger": {"type": "string", "minLength": 1, "description": "对方可观察的言行，原话或客观描述，不写动机"},
    "my_thought": {"type": "string", "minLength": 1, "description": "我当时的原话，不改写"},
    "body": {"type": "string"},
    "urge": {"type": ["integer", "null"], "minimum": 0, "maximum": 10},
    "certainty": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "action": {"enum": ["checked", "chased", "held", "said_ok", "said_stop", "said_no", "other", null]},
    "script_used": {"type": "string"},
    "outcome": {"enum": ["happened", "not_happened", "unverifiable", null]},
    "outcome_fact": {"type": "string", "description": "只记可观察事实；对方的解释不算"},
    "recovery_minutes": {"type": ["integer", "null"], "minimum": 0},
    "suds_peak": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "miss": {"type": ["boolean", "null"]},
    "miss_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "string"},
    "recorded_at": {"type": "string", "description": "ISO 8601 with timezone"},
    "origin": {"enum": ["now", "export", "capture", "inbox", "manual"]},
    "review": {"enum": ["pending", "accepted", "confirmed", "rejected"]}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"enum": ["happened", "not_happened"]}}},
     "then": {"properties": {"outcome_fact": {"minLength": 1}}}},
    {"if": {"properties": {"miss": {"const": true}}},
     "then": {"properties": {"action": {"type": "string"}}}}
  ]
}
